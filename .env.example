# Gmail SMTP (use an App Password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=athletesofthereef@gmail.com
SMTP_PASSWORD=
MAIL_FROM=athletesofthereef@gmail.com
MAIL_TO=athletesofthereef@gmail.com
MAIL_CC=

# Optional APIs (leave blank to skip)
THE_GUARDIAN_API_KEY=
NEWS_API_ORG_KEY=

# Optional / reserved (add sources when wiring these up)
# newsapi.ai (Event Registry) — article search
NEWSAPI_AI_KEY=
# Separate news API key if used alongside newsapi.org
NEWSAPI_COM_KEY=
# Google Programmable Search (Custom Search JSON API)
GOOGLE_API_KEY=
GOOGLE_CX_ID=
# ScraperAPI — redirect/fetch helper only; do not scrape full articles
SCRAPER_API_KEY=

# Schedule in Australia/Brisbane
TZ=Australia/Brisbane
DIGEST_HOUR=7
DIGEST_MINUTE=0
RUN_ON_START=0

# First run only includes items from the last N days
LOOKBACK_DAYS=7
